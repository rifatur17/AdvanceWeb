{
  "info": {
    "name": "NestJS Lab Task 1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order against the local API. Capture screenshots manually in Postman. Re-running creates another second product."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000"
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "secondProductId",
      "value": ""
    },
    {
      "key": "employeeId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Products - required evidence sequence",
      "item": [
        {
          "name": "01-create (capture 01-create.png)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/products",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Notebook\",\n  \"category\": \"Stationery\",\n  \"price\": 125.5,\n  \"quantity\": 20\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Successful HTTP status\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"productId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Setup: create a second product (no screenshot)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/products",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pen\",\n  \"category\": \"Stationery\",\n  \"price\": 15,\n  \"quantity\": 50\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Successful HTTP status\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"secondProductId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "02-get-all (capture 02-get-all.png)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Successful HTTP status\", () => pm.response.to.have.status(200));",
                  "pm.test(\"At least two products\", () => pm.expect(pm.response.json().length).to.be.at.least(2));"
                ]
              }
            }
          ]
        },
        {
          "name": "03-get-by-id (capture 03-get-by-id.png)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Successful HTTP status\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "04-update (capture 04-update.png)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/products/{{productId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 135.75,\n  \"quantity\": 12\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Successful HTTP status\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "05-confirm-update (capture 05-confirm-update.png)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Successful HTTP status\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Updated values\", () => { pm.expect(pm.response.json().price).to.eql(135.75); pm.expect(pm.response.json().quantity).to.eql(12); });"
                ]
              }
            }
          ]
        },
        {
          "name": "06-delete (capture 06-delete.png)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/products/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Successful HTTP status\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "07-confirm-delete (capture 07-confirm-delete.png)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Successful HTTP status\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Deleted product absent\", () => pm.expect(pm.response.json().map(p => p.id)).not.to.include(pm.collectionVariables.get(\"productId\")));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Employees - CRUD verification",
      "item": [
        {
          "name": "Create employee",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/employees",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Lab Employee\",\n  \"email\": \"lab@example.com\",\n  \"phone\": \"+8801700000000\",\n  \"password\": \"dummy-only\",\n  \"age\": 25,\n  \"yearsOfWorking\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Successful HTTP status\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"employeeId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List employees",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/employees"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Successful HTTP status\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get employee",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/employees/{{employeeId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Successful HTTP status\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update employee",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/employees/{{employeeId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"yearsOfWorking\": 4\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Successful HTTP status\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirm employee update",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/employees/{{employeeId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Successful HTTP status\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete employee",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/employees/{{employeeId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Successful HTTP status\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirm employee absent",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/employees"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Successful HTTP status\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Deleted employee absent\", () => pm.expect(pm.response.json().map(e => e.id)).not.to.include(pm.collectionVariables.get(\"employeeId\")));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
